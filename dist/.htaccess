<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: redirect www -> non-www (301, preserve scheme)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ http://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Serve prerendered static HTML for trailing-slash URLs (e.g. /about/ -> /about.html)
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{DOCUMENT_ROOT}%1.html -f
  RewriteRule ^ %1.html [L]

  # Serve prerendered static HTML for clean URLs (e.g. /about -> /about.html)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # Serve existing static assets (files, not directories) directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # SPA fallback for client-side routes
  RewriteRule ^ index.html [L]
</IfModule>